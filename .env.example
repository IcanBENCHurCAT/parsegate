# Parsegate Environment Variables
# Copy this file to .env and fill in the values

# ── Required ──────────────────────────────────────────────────────

# x402 payment facilitator URL
X402_FACILITATOR_URL=https://x402.org/facilitator

# Algorand node URL (mainnet or testnet)
ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud

# Algorand wallet address for receiving USDC payments
AVM_PAY_TO_ADDRESS=

# ── OCR / AI Backends ─────────────────────────────────────────────

# Google Cloud Vision API key for scanned PDF OCR
GOOGLE_CLOUD_VISION_API_KEY=

# Qwen3 local model base URL (OpenAI-compatible API)
# Used for structuring OCR output into unified schema
QWEN3_BASE_URL=http://localhost:8080

# Qwen3 API key (optional, if your model requires auth)
QWEN_API_KEY=

# ── Optional ──────────────────────────────────────────────────────

# Server port
PORT=3000

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# x402 test mode (accepts fake credentials for development)
X402_TEST_MODE=false
